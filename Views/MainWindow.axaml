<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScreenRecorder.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
        Width="450" Height="550"
        x:Class="ScreenRecorder.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Screen Recorder Settings"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="15" Margin="20">
            <TextBlock Text="Screen Recorder Setup" FontSize="20" FontWeight="Bold" />
            
            <TextBlock Text="{Binding StatusMessage}" Foreground="Red" FontWeight="SemiBold" />

            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">
                <!-- Hotkey -->
                <TextBlock Text="Hotkey:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Text="{Binding Settings.Hotkey}" Grid.Row="0" Grid.Column="1" Margin="0,5" />

                <!-- FPS -->
                <TextBlock Text="FPS:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox ItemsSource="{Binding AvailableFps}" SelectedItem="{Binding Settings.Fps}" Grid.Row="1" Grid.Column="1" Margin="0,5" HorizontalAlignment="Stretch"/>

                <!-- Quality -->
                <TextBlock Text="Quality:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Margin="0,5" Spacing="10">
                    <Slider Minimum="10" Maximum="100" Value="{Binding Settings.Quality}" Width="150" />
                    <TextBlock Text="{Binding Settings.Quality, StringFormat=\{0\}%}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Output Path -->
                <TextBlock Text="Output Path:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Text="{Binding Settings.OutputPath}" Grid.Row="3" Grid.Column="1" Margin="0,5" />

                <!-- Start on Startup -->
                <TextBlock Text="Start on Startup:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <CheckBox IsChecked="{Binding Settings.StartOnStartup}" Grid.Row="4" Grid.Column="1" Margin="0,5" />
            </Grid>

            <TextBlock Text="Audio Settings" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <StackPanel Spacing="10">
                <CheckBox Content="Record Device (System) Sound" IsChecked="{Binding Settings.RecordSystemSound}" />
                <CheckBox Content="Record Microphone Sound" IsChecked="{Binding Settings.RecordMicrophone}" />
            </StackPanel>

            <TextBlock Text="Recording Area" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <StackPanel Spacing="10">
                <RadioButton Content="Full Screen" IsChecked="{Binding Settings.IsFullScreen}" />
                <RadioButton Content="Target Area" IsChecked="{Binding !Settings.IsFullScreen}" />
                <Button Content="Select Target Area" 
                        IsEnabled="{Binding !Settings.IsFullScreen}" 
                        Click="OnSelectAreaClick" 
                        HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Settings.RegionLeft, StringFormat='Region: X:{0}'}" FontSize="12" Foreground="Gray" />
            </StackPanel>

            <TextBlock Text="Screenshot" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="Screenshot Hotkey:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Text="{Binding Settings.ScreenshotHotkey}" Grid.Column="1" PlaceholderText="Alt+D" />
                </Grid>
                <TextBlock Text="Default: Alt+D. Pressing it captures the screen at full resolution and opens the editor, where you can crop, copy or save the image."
                           FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
                <Button Content="Take Screenshot Now" Click="OnTakeScreenshotClick" HorizontalAlignment="Left" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>