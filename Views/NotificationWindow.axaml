<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScreenRecorder.Views.NotificationWindow"
        Title="Recording Saved"
        Width="350" Height="80"
        WindowDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="Manual">

    <Border Background="#1E1E1E" 
            BorderBrush="#2D2D2D" 
            BorderThickness="1" 
            CornerRadius="6" 
            ClipToBounds="True"
            PointerPressed="OnNotificationClick"
            Cursor="Hand">
        <Grid ColumnDefinitions="6,Auto,*,Auto" Margin="0,0,10,0">
            <!-- Left Accent Bar -->
            <Rectangle Grid.Column="0" Fill="#0078D4" Width="4" VerticalAlignment="Stretch" HorizontalAlignment="Left" />
            
            <!-- Icon -->
            <PathIcon Grid.Column="1" 
                      Data="M10,90 L10,10 L30,10 L70,70 L70,10 L90,10 L90,90 L70,90 L30,30 L30,90 Z" 
                      Width="20" Height="20" 
                      Foreground="#0078D4" 
                      Margin="15,0,10,0" 
                      VerticalAlignment="Center"/>
            
            <!-- Text Content -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Recording Completed" FontWeight="Bold" FontSize="14" Foreground="White" />
                <TextBlock Text="Click to open the output folder." FontSize="11" Foreground="#CCCCCC" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Close Button -->
            <Button Grid.Column="3" 
                    Content="✕" 
                    Background="Transparent" 
                    BorderBrush="Transparent"
                    Foreground="#888888"
                    FontSize="12"
                    Padding="5"
                    Click="OnCloseClick"
                    VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
